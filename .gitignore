# --- R session artifacts ---
.Rhistory
.RData
.Ruserdata
*.Rproj.user
.Rproj.user/

# --- renv (dependency lockfiles stay; local library excluded) ---
renv/library/
renv/local/
renv/staging/
renv/cellar/
renv/python/
renv/sandbox/
renv/.gitignore

# --- build artifacts ---
*.Rcheck/
*.tar.gz
*.zip
src/*.o
src/*.so
src/*.dll

# --- data raw / large archives (P2 data pipeline) ---
data-raw/
data-interim/
TCMNP-main.zip
*.rds.bak
*.sqlite
*.fst
*.parquet

# --- docs big files ---
docs/*.txt
docs/*.log
docs/*.zip
docs/*.exe

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
.vscode/

# --- inst/extdata 数据件例外（parquet 为包内运行时数据，必须入库）----
# 说明：P4 exe 分发包的离线数据源即 inst/extdata/*.parquet，
#       上游规则 `*.parquet` 会误伤，故此处显式反忽略。
!inst/extdata/*.parquet
